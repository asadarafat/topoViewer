{
  "name": "topoviewer-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Monorepo for TopoViewer packages.",
  "workspaces": [
    "packages/topoviewer",
    "packages/grafana-topoviewer-panel",
    "packages/vscode-topoviewer"
  ],
  "scripts": {
    "dev": "npm --workspace topoviewer run dev",
    "vscode:harness": "node scripts/require-node24.mjs && npm --workspace vscode-topoviewer run vscode:harness",
    "vscode:harness:build": "node scripts/require-node24.mjs && npm --workspace vscode-topoviewer run vscode:harness:build && npm run validate:vscode-harness-build",
    "clean": "npm --workspace topoviewer run clean",
    "build": "node scripts/require-node24.mjs && npm --workspace topoviewer run build && npm --workspace grafana-topoviewer-panel run build && npm --workspace vscode-topoviewer run build",
    "sync:mkdocs-assets": "npm --workspace topoviewer run sync:mkdocs-assets",
    "sync:zensical-assets": "node scripts/sync-zensical-assets.mjs",
    "sync:zensical-docs": "node scripts/sync-zensical-docs.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "check:content": "node scripts/sync-content.mjs --check",
    "pages:redirects": "node scripts/write-pages-redirects.mjs",
    "sync:docs-site": "node scripts/sync-docs-site.mjs",
    "sync:examples": "npm --workspace topoviewer run sync:examples",
    "sync:docs": "npm run sync:content && npm run sync:docs-site && npm run sync:examples",
    "check:examples": "npm run check:content && npm --workspace topoviewer run check:examples",
    "grafana:fixtures:sync": "node scripts/require-node24.mjs && node scripts/sync-grafana-harness-fixtures.mjs",
    "grafana:fixtures:check": "node scripts/require-node24.mjs && node scripts/check-grafana-harness-fixtures.mjs",
    "grafana:injector:test": "node scripts/require-node24.mjs && node --test labs/grafana-topoviewer/telemetry-injector/tests/scenarios.test.mjs",
    "grafana:panel:build": "node scripts/require-node24.mjs && npm --workspace grafana-topoviewer-panel run build",
    "grafana:panel:test": "node scripts/require-node24.mjs && npm --workspace grafana-topoviewer-panel run test",
    "grafana:lab:inject": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/scripts/inject-telemetry.mjs",
    "grafana:lab:up": "node scripts/require-node24.mjs && bash labs/grafana-topoviewer/scripts/up.sh",
    "grafana:lab:down": "bash labs/grafana-topoviewer/scripts/down.sh",
    "grafana:lab:smoke:phase1": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/scripts/smoke-grafana-phase-1.mjs",
    "grafana:lab:smoke:phase2": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/scripts/smoke-grafana-phase-2.mjs",
    "grafana:lab:smoke:phase4": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/scripts/smoke-grafana-phase-4.mjs",
    "grafana:clab:up": "node scripts/require-node24.mjs && bash labs/grafana-topoviewer/containerlab/scripts/up.sh",
    "grafana:clab:down": "bash labs/grafana-topoviewer/containerlab/scripts/down.sh",
    "grafana:clab:restart": "node scripts/require-node24.mjs && bash labs/grafana-topoviewer/containerlab/scripts/restart.sh",
    "grafana:clab:smoke": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/containerlab/scripts/smoke.mjs",
    "grafana:clab:smoke:upstream": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/containerlab/scripts/smoke-upstream-candidate.mjs",
    "grafana:clab:rules": "node scripts/require-node24.mjs && node labs/grafana-topoviewer/containerlab/scripts/generate-prometheus-rules.mjs",
    "grafana:clab:traffic:start": "bash labs/grafana-topoviewer/containerlab/scripts/traffic.sh start",
    "grafana:clab:traffic:stop": "bash labs/grafana-topoviewer/containerlab/scripts/traffic.sh stop",
    "grafana:clab:traffic:status": "bash labs/grafana-topoviewer/containerlab/scripts/traffic.sh status",
    "sync:mkdocs": "npm --workspace topoviewer run sync:mkdocs",
    "validate:schemas": "npm --workspace topoviewer run validate:schemas",
    "validate:semantics": "npm --workspace topoviewer run validate:semantics",
    "validate:vscode-harness-build": "node scripts/check-vscode-harness-build.mjs",
    "docs:smoke": "node scripts/require-node24.mjs && node scripts/smoke-docs-site.mjs",
    "docs:lint": "node scripts/lint-docs.mjs",
    "public-readiness": "node scripts/require-node24.mjs && node scripts/check-public-readiness.mjs",
    "dependency:advisories": "node scripts/require-node24.mjs && node scripts/check-dependency-advisories.mjs",
    "install:check": "node scripts/require-node24.mjs && node scripts/check-install-commands.mjs",
    "artifact:check": "node scripts/require-node24.mjs && node scripts/check-release-artifacts.mjs",
    "artifact:check:docs": "node scripts/require-node24.mjs && node scripts/check-release-artifacts.mjs --scope docs",
    "artifact:check:package": "node scripts/require-node24.mjs && node scripts/check-release-artifacts.mjs --scope package",
    "render:parity": "node scripts/require-node24.mjs && node scripts/check-renderer-surface-parity.mjs",
    "dense:fixture": "npm --workspace topoviewer run dense:fixture",
    "benchmark:attention": "npm --workspace topoviewer run benchmark:attention --",
    "benchmark:attention:smoke": "npm --workspace topoviewer run benchmark:attention:smoke",
    "benchmark:attention:local": "npm --workspace topoviewer run benchmark:attention -- --nodes 1000,5000,10000 --output .artifacts/benchmarks/attention.json",
    "benchmark:clos": "npm --workspace topoviewer run benchmark:clos --",
    "benchmark:clos:smoke": "npm --workspace topoviewer run benchmark:clos:smoke",
    "benchmark:clos:local": "npm --workspace topoviewer run benchmark:clos -- --nodes 1000,5000 --output .artifacts/benchmarks/clos-layout.json",
    "lint": "npm run lint:code-health && npm run lint:ts && npm run typecheck:tests && npm run lint:deps && npm run lint:cpd",
    "lint:code-health": "node scripts/check-code-health.mjs",
    "lint:ts": "oxlint packages/topoviewer/src packages/topoviewer/scripts packages/topoviewer/tests packages/grafana-topoviewer-panel/src packages/grafana-topoviewer-panel/scripts packages/grafana-topoviewer-panel/tests packages/vscode-topoviewer/src packages/vscode-topoviewer/scripts packages/vscode-topoviewer/tests scripts labs/grafana-topoviewer/scripts labs/grafana-topoviewer/containerlab/scripts labs/grafana-topoviewer/containerlab/normalizer --ignore-path .gitignore",
    "typecheck:tests": "npm --workspace topoviewer run typecheck:tests",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages/topoviewer/src packages/topoviewer/scripts packages/topoviewer/tests packages/grafana-topoviewer-panel/src packages/grafana-topoviewer-panel/tests packages/vscode-topoviewer/src packages/vscode-topoviewer/scripts packages/vscode-topoviewer/tests scripts",
    "lint:circular": "npm run lint:deps",
    "lint:cpd": "jscpd --config .jscpd.json --no-tips",
    "lint:cpd:report": "jscpd --config .jscpd.json --reporters console --no-tips",
    "quality": "npm --workspace topoviewer run build:types && npm run lint && npm --workspace grafana-topoviewer-panel run typecheck && npm --workspace vscode-topoviewer run typecheck",
    "test": "npm --workspace topoviewer run test",
    "test:vscode-harness": "node scripts/require-node24.mjs && npm --workspace vscode-topoviewer run test:vscode-harness",
    "test:headed": "npm --workspace topoviewer run test:headed",
    "test:all": "npm --workspace topoviewer run test:all",
    "transfer:bundle": "node scripts/create-manual-transfer.mjs",
    "pack:check": "npm --workspace topoviewer run pack:check",
    "wheel:mkdocs": "rm -rf .artifacts/wheels && python3 -m pip wheel packages/mkdocs-topoviewer --no-deps -w .artifacts/wheels",
    "inspect:wheel": "python3 scripts/inspect-mkdocs-wheel.py .artifacts/wheels",
    "validate:zensical": "node scripts/check-zensical-build.mjs",
    "docs:setup": "bash scripts/local-mkdocs.sh setup",
    "docs:build": "bash scripts/local-mkdocs.sh build",
    "docs:build:parallel": "bash scripts/build-parallel-docs.sh",
    "docs:build:fast": "TOPOVIEWER_DOCS_SKIP_VIEWER_BUILD=1 bash scripts/local-mkdocs.sh build",
    "docs:serve": "bash scripts/local-mkdocs.sh serve",
    "docs:serve:fast": "TOPOVIEWER_DOCS_SKIP_VIEWER_BUILD=1 bash scripts/local-mkdocs.sh serve",
    "docs:preview": "bash scripts/local-docs-preview.sh",
    "docs:preview:fast": "TOPOVIEWER_DOCS_SKIP_VIEWER_BUILD=1 TOPOVIEWER_ZENSICAL_SKIP_VIEWER_BUILD=1 bash scripts/local-docs-preview.sh",
    "docs:clean": "bash scripts/local-mkdocs.sh clean",
    "mkdocs:build": "bash scripts/local-mkdocs.sh build",
    "zensical:setup": "bash scripts/local-zensical.sh setup",
    "zensical:build": "bash scripts/local-zensical.sh build && npm run validate:zensical",
    "zensical:serve": "bash scripts/local-zensical.sh serve",
    "ci": "node scripts/require-node24.mjs && node scripts/ci.mjs",
    "ci:env": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane env",
    "ci:generated": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane generated",
    "ci:quality": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane quality",
    "ci:schemas": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane schemas",
    "ci:build": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane build",
    "ci:docs": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane docs",
    "ci:render-parity": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane render-parity",
    "ci:test:topoviewer": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane test:topoviewer",
    "ci:test:harness": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane test:harness",
    "ci:perf:smoke": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane perf:smoke",
    "ci:package": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane package",
    "ci:public-readiness": "node scripts/require-node24.mjs && node scripts/ci.mjs --lane public-readiness",
    "ci:remote-parity": "node scripts/require-node24.mjs && node scripts/ci.mjs --remote-parity"
  },
  "overrides": {
    "monaco-editor": "0.53.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.4.3",
    "jscpd": "^5.0.11",
    "oxlint": "^1.71.0"
  }
}
