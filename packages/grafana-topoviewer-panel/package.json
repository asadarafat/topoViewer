{
  "name": "grafana-topoviewer-panel",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Exploratory Grafana panel plugin for rendering TopoViewer harness fixtures.",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/require-node24.mjs && node scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/require-node24.mjs && npm --workspace topoviewer run build:lib && vitest run && go test ./..."
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "js-yaml": "^4.1.0",
    "topoviewer": "0.1.0"
  },
  "devDependencies": {
    "@grafana/data": "13.1.0",
    "@grafana/runtime": "13.1.0",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.15.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
