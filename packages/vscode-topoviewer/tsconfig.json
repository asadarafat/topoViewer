{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../..",
    "paths": {
      "topoviewer": ["packages/topoviewer/src/index.ts"],
      "topoviewer/authoring": ["packages/topoviewer/src/authoring.ts"],
      "topoviewer/integration": ["packages/topoviewer/src/integration.ts"],
      "topoviewer-studio": ["packages/topoviewer-studio/src/index.ts"],
      "topoviewer-studio/app": ["packages/topoviewer-studio/src/app.ts"],
      "topoviewer-studio/host": ["packages/topoviewer-studio/src/contracts/host.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vscode"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.webview.config.ts",
    "vite.harness.config.ts",
    "vite.studio-host.config.ts",
    "playwright.studio-host.config.ts",
    "playwright.config.js"
  ]
}
