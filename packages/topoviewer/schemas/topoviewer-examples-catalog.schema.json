{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topoviewer.dev/schemas/topoviewer-examples-catalog.schema.json",
  "title": "TopoViewer Examples Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "examples"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "feature", "path", "page", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$"
          },
          "sourceFiles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "readme": {
                "$ref": "#/definitions/sourceFile"
              },
              "topology": {
                "$ref": "#/definitions/sourceFile"
              },
              "stylesheet": {
                "$ref": "#/definitions/sourceFile"
              },
              "expected": {
                "$ref": "#/definitions/sourceFile"
              }
            }
          },
          "fixture": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "publicPage": {
            "type": "boolean",
            "description": "When false, sync-examples still syncs the fixture assets but does not generate a standalone public example page or list item."
          },
          "introMode": {
            "type": "string",
            "enum": ["standard", "narrative"],
            "description": "Use narrative for story/tutorial pages where the README owns the page body, including embedded viewports, instead of receiving generated What/Expected/Inspect/Use sections or bottom viewport/YAML tabs."
          },
          "extraFiles": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/sourceFile"
            },
            "uniqueItems": true,
            "description": "Additional example-local assets that should be projected beside topology.yaml and stylesheet.yaml."
          },
          "page": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "render": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "height": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "controls": {
                "type": "boolean"
              },
              "controlsOpen": {
                "type": "boolean"
              },
              "helperLines": {
                "$ref": "topoviewer-mkdocs-block.schema.json#/definitions/helperLines"
              },
              "selectedLayerIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "attention": {
                "$ref": "topoviewer-mkdocs-block.schema.json#/definitions/attention"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "sourceFile": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_.-]*(/[a-z0-9_][a-z0-9_.-]*)*$"
    }
  }
}
