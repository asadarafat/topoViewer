{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topoviewer.dev/schemas/topoviewer-examples-catalog.schema.json",
  "title": "TopoViewer Examples Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "examples"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "feature", "path", "page", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$"
          },
          "page": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "render": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "height": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "controls": {
                "type": "boolean"
              },
              "controlsOpen": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
