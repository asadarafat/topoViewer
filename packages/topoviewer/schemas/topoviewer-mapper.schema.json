{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topoviewer.dev/schemas/topoviewer-mapper.schema.json",
  "title": "TopoViewer mapper document",
  "description": "Maps Grafana or operational telemetry metrics to TopoViewer objects and runtime overlays.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "anyOf": [
    {
      "properties": {
        "rules": {
          "type": "array"
        }
      },
      "required": ["rules"]
    },
    {
      "properties": {
        "mappings": {
          "type": "array"
        }
      },
      "required": ["mappings"]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Mapper schema version."
    },
    "identity": {
      "$ref": "#/definitions/identity"
    },
    "palette": {
      "$ref": "#/definitions/severityPalette"
    },
    "rules": {
      "type": "array",
      "description": "Human-friendly mapper authoring rules. Rules compile to canonical mappings at runtime.",
      "items": {
        "$ref": "#/definitions/authoringRule"
      }
    },
    "mappings": {
      "type": "array",
      "description": "Canonical metric-to-object mapping rules. Prefer rules for hand-authored mapper YAML unless the advanced shape is needed.",
      "items": {
        "$ref": "#/definitions/mapping"
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional source identity filter applied before mapping telemetry samples.",
      "properties": {
        "sourceId": {
          "type": "string",
          "description": "Expected source identity value."
        },
        "sourceIdLabel": {
          "type": "string",
          "description": "Telemetry label carrying the source identity."
        }
      }
    },
    "severityPalette": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional severity color palette used by severity-driven runtime overlays.",
      "properties": {
        "success": {
          "$ref": "#/definitions/severityPaletteEntry"
        },
        "info": {
          "$ref": "#/definitions/severityPaletteEntry"
        },
        "warning": {
          "$ref": "#/definitions/severityPaletteEntry"
        },
        "error": {
          "$ref": "#/definitions/severityPaletteEntry"
        }
      }
    },
    "severityPaletteEntry": {
      "description": "Severity color. Use a string shorthand or a mapping when label/accent color should differ from the main overlay color.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "description": "Main overlay color for lines, borders, backgrounds, outlines, and status markers."
            },
            "accent": {
              "type": "string",
              "description": "Text/accent color for labels derived from this severity."
            }
          }
        }
      ]
    },
    "authoringRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "select"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable mapper rule identifier."
        },
        "metric": {
          "type": "string",
          "description": "Grafana data-frame metric name to match."
        },
        "select": {
          "type": "string",
          "description": "TopoViewer selector or object kind, such as link, linkDirection, node, node[labels.role = \"pe\"], path, region, layer, or graph."
        },
        "join": {
          "description": "Telemetry label carrying the selected object's ID, or a linkDirection join object with link and direction labels. Omit for selector-wide rules.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/linkDirectionJoin"
            }
          ]
        },
        "value": {
          "type": "string",
          "description": "Short value semantic. Supported values include percent, utilizationPercent, up, errorsTotal, latencyMs, lossPercent, capacityPercent, bps, and health.",
          "enum": ["percent", "utilization", "utilizationPercent", "up", "errors", "errorsTotal", "latency", "latencyMs", "loss", "lossPercent", "capacity", "capacityPercent", "bps", "health"]
        },
        "states": {
          "type": "object",
          "description": "State names mapped to simple value expressions. Examples: down: \"==0\", busy: \">=70\", saturated: \">=90\".",
          "additionalProperties": {
            "type": "string"
          }
        },
        "style": {
          "type": "object",
          "description": "Runtime style by state. style.default applies first; style.<state> overrides when the matching states.<state> expression is true.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "target"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable mapping rule identifier."
        },
        "metric": {
          "type": "string",
          "description": "Grafana data-frame metric name to match."
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "value": {
          "$ref": "#/definitions/value"
        },
        "thresholds": {
          "$ref": "#/definitions/thresholds"
        },
        "overlay": {
          "$ref": "#/definitions/overlay"
        },
        "conditions": {
          "type": "array",
          "description": "Conditional runtime style rules evaluated after the base overlay. Use this for selector-like dynamic style changes from telemetry values.",
          "items": {
            "$ref": "#/definitions/conditionalStyle"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resolve"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "TopoViewer object kind affected by the metric.",
          "enum": ["node", "link", "linkDirection", "path", "region", "layer", "graph"]
        },
        "resolve": {
          "$ref": "#/definitions/resolver"
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": {
          "type": "string",
          "description": "How telemetry labels resolve to TopoViewer objects.",
          "enum": ["id", "label", "data", "endpoint", "selector", "aggregate", "staticObjectIds"]
        },
        "metricLabel": {
          "type": "string",
          "description": "Telemetry label used as the primary join value."
        },
        "linkMetricLabel": {
          "type": "string",
          "description": "Telemetry label carrying the parent link ID for linkDirection joins."
        },
        "directionMetricLabel": {
          "type": "string",
          "description": "Telemetry label carrying sourceToTarget or targetToSource for linkDirection joins."
        },
        "key": {
          "type": "string",
          "description": "TopoViewer label or data key used by label/data resolvers."
        },
        "sourceLabel": {
          "type": "string",
          "description": "Telemetry label carrying source node ID for endpoint matching."
        },
        "targetLabel": {
          "type": "string",
          "description": "Telemetry label carrying target node ID for endpoint matching."
        },
        "selector": {
          "type": "string",
          "description": "TopoViewer selector used by selector resolver."
        },
        "objectIds": {
          "type": "array",
          "description": "Explicit TopoViewer object IDs for static object matching.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "linkDirectionJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link", "direction"],
      "properties": {
        "link": {
          "type": "string",
          "description": "Telemetry label carrying the parent TopoViewer link ID."
        },
        "direction": {
          "type": "string",
          "description": "Telemetry label carrying sourceToTarget or targetToSource."
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "Data-frame field to read. Defaults to the sample value."
        },
        "as": {
          "type": "string",
          "description": "Semantic interpretation of the metric value.",
          "enum": ["up", "utilizationPercent", "errorsTotal", "latencyMs", "lossPercent", "capacityPercent", "bps", "health"]
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "info": {
          "type": "number"
        },
        "warning": {
          "type": "number"
        },
        "error": {
          "type": "number"
        },
        "direction": {
          "type": "string",
          "enum": ["above", "below"],
          "default": "above"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineColorBySeverity": {
          "type": "boolean"
        },
        "lineWidthBySeverity": {
          "type": "boolean"
        },
        "sourceArrowColorBySeverity": {
          "type": "boolean"
        },
        "targetArrowColorBySeverity": {
          "type": "boolean"
        },
        "outlineBySeverity": {
          "type": "boolean"
        },
        "statusMarker": {
          "type": "boolean"
        },
        "backgroundColorBySeverity": {
          "type": "boolean"
        },
        "borderColorBySeverity": {
          "type": "boolean"
        },
        "badgeLabel": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "propagateToLayerMembers": {
          "type": "boolean"
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "conditionalStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional stable condition identifier for diagnostics and reviews."
        },
        "when": {
          "$ref": "#/definitions/condition"
        },
        "style": {
          "type": "object",
          "description": "TopoViewer style patch applied when the condition matches. String values may use mapper templates such as {{ value }}, {{ value | round }}, {{ value | bps }}, {{ severity }}, {{ metric }}, {{ target.id }}, {{ label.name }}, and {{ field.name }}.",
          "additionalProperties": true
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "description": "All specified condition fields must match for the style patch to apply.",
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["none", "success", "info", "warning", "error"]
        },
        "value": {
          "$ref": "#/definitions/scalarCondition"
        },
        "label": {
          "$ref": "#/definitions/keyedCondition"
        },
        "field": {
          "$ref": "#/definitions/keyedCondition"
        }
      }
    },
    "scalarCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eq": {
          "$ref": "#/definitions/conditionScalar"
        },
        "ne": {
          "$ref": "#/definitions/conditionScalar"
        },
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "contains": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "keyedCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "description": "Telemetry label or field key to test."
        },
        "eq": {
          "$ref": "#/definitions/conditionScalar"
        },
        "ne": {
          "$ref": "#/definitions/conditionScalar"
        },
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "contains": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "conditionScalar": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
