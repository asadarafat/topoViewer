{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topoviewer.dev/schemas/topoviewer-examples-manifest.schema.json",
  "title": "TopoViewer Examples Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["examples"],
  "properties": {
    "version": {
      "type": "string"
    },
    "docsRoot": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "page"],
        "anyOf": [
          {
            "required": ["topology", "stylesheet"],
            "properties": {
              "topology": true,
              "stylesheet": true
            }
          },
          {
            "required": ["source", "mkdocs"],
            "properties": {
              "source": true,
              "mkdocs": true
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "renderable": {
            "type": "boolean"
          },
          "topology": {
            "type": "string",
            "minLength": 1
          },
          "stylesheet": {
            "type": "string",
            "minLength": 1
          },
          "readme": {
            "type": "string",
            "minLength": 1
          },
          "markdown": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/definitions/exampleFiles"
          },
          "mkdocs": {
            "$ref": "#/definitions/exampleFiles"
          },
          "expected": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "graphNodes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "shapes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "visibleCallouts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "texts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minVisibleEdges": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minRegions": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "assertions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "controls": {
                "type": "boolean"
              },
              "deepZoomMin": {
                "type": "number",
                "minimum": 1
              },
              "svgIcons": {
                "type": "boolean"
              },
              "themeVariables": {
                "type": "boolean"
              },
              "geometryOnlyShapes": {
                "type": "boolean"
              },
              "markdownCallout": {
                "type": "boolean"
              },
              "stitchedChildPaths": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "exampleFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "stylesheet"],
      "properties": {
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "stylesheet": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
