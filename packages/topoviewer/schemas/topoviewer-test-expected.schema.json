{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topoviewer.dev/schemas/topoviewer-test-expected.schema.json",
  "title": "TopoViewer Test Expected Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["renderable", "visualSnapshot", "dom", "assertions", "semantic"],
  "properties": {
    "renderable": {
      "type": "boolean"
    },
    "visualSnapshot": {
      "type": "boolean"
    },
    "dom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graphNodes": {
          "type": "integer",
          "minimum": 0
        },
        "shapes": {
          "type": "integer",
          "minimum": 0
        },
        "visibleCallouts": {
          "type": "integer",
          "minimum": 0
        },
        "minVisibleEdges": {
          "type": "integer",
          "minimum": 0
        },
        "minRegions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "number", "string"]
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings"],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
