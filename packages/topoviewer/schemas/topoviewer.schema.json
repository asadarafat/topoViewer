{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topoviewer.dev/schemas/topoviewer.schema.json",
  "title": "TopoViewer document",
  "description": "Combined TopoViewer topology and stylesheet document.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "graph": {
      "$ref": "#/definitions/graph"
    },
    "diagram": {
      "$ref": "#/definitions/diagram"
    },
    "toggles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/toggle"
      }
    },
    "layout": {
      "$ref": "#/definitions/layout"
    },
    "limits": {
      "$ref": "#/definitions/limits"
    },
    "attention": {
      "$ref": "topoviewer-mkdocs-block.schema.json#/definitions/attention"
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/icon"
      }
    },
    "labelFields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stylesheet": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/styleRule"
      }
    }
  },
  "definitions": {
    "scalar": {
      "type": ["string", "number", "boolean"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/scalar"
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "nodeLayout": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["card"]
        },
        "direction": {
          "type": "string",
          "enum": ["horizontal"]
        },
        "icon": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "placement": {
              "type": "string",
              "enum": ["left"]
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "align": {
              "type": "string",
              "enum": ["left", "center", "right"]
            },
            "titleField": {
              "type": "string",
              "minLength": 1
            },
            "subtitleField": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "-"
        }
      },
      "properties": {
        "shape": {
          "type": "string",
          "description": "Shape name. For graph nodes, use canonical TopoViewer node shape values such as ellipse, circle, square, rectangle, roundRectangle, hexagon, star, or polygon."
        },
        "nodeLayout": {
          "$ref": "#/definitions/nodeLayout",
          "description": "Nested node content layout. Use nodeLayout.type: card with explicit shape: roundRectangle."
        },
        "shapePolygonPoints": {
          "description": "Custom graph-node polygon points in normalized [-1, 1] x/y coordinate space.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 6,
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "labelPosition": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left",
            "center",
            "topLeft",
            "topCenter",
            "topRight",
            "rightTop",
            "rightCenter",
            "rightBottom",
            "bottomRight",
            "bottomCenter",
            "bottomLeft",
            "leftTop",
            "leftCenter",
            "leftBottom"
          ],
          "description": "Node labels support top, right, bottom, left, and center. Region labels support topLeft, topCenter, topRight, rightTop, rightCenter, rightBottom, bottomRight, bottomCenter, bottomLeft, leftTop, leftCenter, and leftBottom."
        },
        "labelMargin": {
          "type": "number",
          "minimum": 0,
          "description": "Uniform region-label margin in pixels from the selected region edge."
        },
        "labelXOffset": {
          "type": "number"
        },
        "labelYOffset": {
          "type": "number"
        },
        "labelCollisionPolicy": {
          "type": "string",
          "enum": ["none", "avoid", "fade", "hide"],
          "description": "Collision behavior for automatically placed labels when overlap cannot be avoided."
        },
        "labelTextWrap": {
          "type": "string",
          "enum": ["none", "wrap"]
        },
        "labelTextMaxWidth": {
          "type": "number",
          "minimum": 0
        },
        "labelTextOverflow": {
          "type": "string",
          "enum": ["clip", "ellipsis"]
        },
        "labelTextAlign": {
          "type": "string"
        },
        "labelBackgroundColor": {
          "type": "string"
        },
        "labelBackgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "labelOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "labelPadding": {
          "type": "number",
          "minimum": 0
        },
        "minZoomedLabelFontSize": {
          "type": "number",
          "minimum": 0
        },
        "borderStyle": {
          "type": "string",
          "enum": ["solid", "dashed", "dotted"]
        },
        "borderDashPattern": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array",
              "items": { "type": "number" }
            },
            { "type": "string" }
          ]
        },
        "borderOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "outlineColor": {
          "type": "string"
        },
        "outlineWidth": {
          "type": "number",
          "minimum": 0
        },
        "outlineOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "underlayColor": {
          "type": "string"
        },
        "underlayPadding": {
          "type": "number",
          "minimum": 0
        },
        "underlayOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "iconOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "iconPadding": {
          "type": "number",
          "minimum": 0
        },
        "iconFit": {
          "type": "string",
          "enum": ["contain", "cover", "fill"]
        },
        "iconBackgroundColor": {
          "type": "string"
        },
        "badgeLabel": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ]
        },
        "badgeColor": {
          "type": "string"
        },
        "badgeBackgroundColor": {
          "type": "string"
        },
        "badgeBorderColor": {
          "type": "string"
        },
        "badgeBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "badgeFontSize": {
          "type": "number",
          "minimum": 0
        },
        "badgeFontWeight": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ]
        },
        "badgeMinWidth": {
          "type": "number",
          "minimum": 0
        },
        "badgeMinHeight": {
          "type": "number",
          "minimum": 0
        },
        "badgePadding": {
          "type": "number",
          "minimum": 0
        },
        "badgeOffset": {
          "type": "number",
          "minimum": 0
        },
        "badgePosition": {
          "type": "string",
          "enum": ["topLeft", "topRight", "bottomLeft", "bottomRight"]
        },
        "statusColor": {
          "type": "string"
        },
        "statusPlacement": {
          "type": "string",
          "enum": ["topLeft", "topRight", "bottomLeft", "bottomRight", "center"]
        },
        "statusSize": {
          "type": "number",
          "minimum": 0
        },
        "sourceArrowShape": {
          "type": "string",
          "enum": ["none", "triangle", "vee", "tee", "circle", "square", "diamond"]
        },
        "targetArrowShape": {
          "type": "string",
          "enum": ["none", "triangle", "vee", "tee", "circle", "square", "diamond"]
        },
        "sourceArrowColor": {
          "type": "string"
        },
        "targetArrowColor": {
          "type": "string"
        },
        "sourceArrowBorderColor": {
          "type": "string"
        },
        "targetArrowBorderColor": {
          "type": "string"
        },
        "sourceArrowBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "targetArrowBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "sourceArrowSize": {
          "type": "number",
          "minimum": 0
        },
        "targetArrowSize": {
          "type": "number",
          "minimum": 0
        },
        "sourceArrowOffset": {
          "type": "number"
        },
        "targetArrowOffset": {
          "type": "number"
        },
        "edgeLabelColor": {
          "type": "string"
        },
        "labelBorderColor": {
          "type": "string"
        },
        "labelBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "labelFontStyle": {
          "type": "string"
        },
        "labelZIndex": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ],
          "description": "Independent label draw order. Use zIndex for the object body or edge line."
        },
        "metaZIndex": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ],
          "description": "Independent draw order for node metadata when rendered as a collision-managed overlay."
        },
        "sourceLabelColor": {
          "type": "string"
        },
        "sourceLabel": {
          "type": ["string", "number", "boolean"]
        },
        "sourceLabelBackgroundColor": {
          "type": "string"
        },
        "sourceLabelBorderColor": {
          "type": "string"
        },
        "sourceLabelBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "sourceLabelFontSize": {
          "oneOf": [
            { "type": "string" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "sourceLabelFontWeight": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ]
        },
        "sourceLabelFontStyle": {
          "type": "string"
        },
        "sourceLabelOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceLabelAutoPosition": {
          "type": "boolean"
        },
        "sourceLabelDistance": {
          "type": "number",
          "minimum": 0
        },
        "sourceLabelMaxDistance": {
          "type": "number",
          "minimum": 0
        },
        "sourceLabelSideOffset": {
          "type": "number"
        },
        "sourceLabelZIndex": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ],
          "description": "Independent draw order for the source endpoint edge label. Falls back to labelZIndex when omitted."
        },
        "targetLabelColor": {
          "type": "string"
        },
        "targetLabel": {
          "type": ["string", "number", "boolean"]
        },
        "targetLabelBackgroundColor": {
          "type": "string"
        },
        "targetLabelBorderColor": {
          "type": "string"
        },
        "targetLabelBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "targetLabelFontSize": {
          "oneOf": [
            { "type": "string" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "targetLabelFontWeight": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ]
        },
        "targetLabelFontStyle": {
          "type": "string"
        },
        "targetLabelOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "targetLabelAutoPosition": {
          "type": "boolean"
        },
        "targetLabelDistance": {
          "type": "number",
          "minimum": 0
        },
        "targetLabelMaxDistance": {
          "type": "number",
          "minimum": 0
        },
        "targetLabelSideOffset": {
          "type": "number"
        },
        "targetLabelZIndex": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ],
          "description": "Independent draw order for the target endpoint edge label. Falls back to labelZIndex when omitted."
        },
        "sourceLabelXOffset": {
          "type": "number"
        },
        "sourceLabelYOffset": {
          "type": "number"
        },
        "targetLabelXOffset": {
          "type": "number"
        },
        "targetLabelYOffset": {
          "type": "number"
        },
        "endpointLabelAutoPosition": {
          "type": "boolean"
        },
        "endpointLabelDistance": {
          "type": "number",
          "minimum": 0
        },
        "endpointLabelMaxDistance": {
          "type": "number",
          "minimum": 0
        },
        "endpointLabelSideOffset": {
          "type": "number"
        },
        "endpointLabelOverlayLayer": {
          "type": "string",
          "minLength": 1
        },
        "sourceLabelOverlayLayer": {
          "type": "string",
          "minLength": 1
        },
        "targetLabelOverlayLayer": {
          "type": "string",
          "minLength": 1
        },
        "sourceDistanceFromNode": {
          "type": "number",
          "minimum": 0
        },
        "targetDistanceFromNode": {
          "type": "number",
          "minimum": 0
        },
        "directionalStrokes": {
          "type": "boolean"
        },
        "directionCenterGap": {
          "type": "number",
          "minimum": 0
        },
        "directionStartGap": {
          "type": "number",
          "minimum": 0
        },
        "directionLabelPlacement": {
          "type": "string",
          "enum": ["center", "source", "target", "outside"]
        },
        "directionLabelOffset": {
          "type": "number"
        },
        "directionLabelRotation": {
          "type": "string",
          "enum": ["none", "auto"]
        },
        "directionOverlayLayer": {
          "type": "string",
          "minLength": 1
        },
        "segmentDistances": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array",
              "items": { "type": "number" }
            },
            { "type": "string" }
          ]
        },
        "segmentWeights": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array",
              "items": { "type": "number" }
            },
            { "type": "string" }
          ]
        },
        "taxiDirection": {
          "type": "string",
          "enum": ["auto", "vertical", "downward", "upward", "horizontal", "rightward", "leftward"]
        },
        "taxiTurn": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "taxiTurnMinDistance": {
          "type": "number",
          "minimum": 0
        },
        "lineFill": {
          "type": "string",
          "enum": ["solid", "linearGradient"]
        },
        "lineGradientStopColors": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 2
            },
            { "type": "string" }
          ]
        },
        "lineGradientStopPositions": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            { "type": "string" }
          ]
        },
        "interactive": {
          "type": "boolean"
        },
        "labelInteractive": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 1
        },
        "maxPathSegments": {
          "type": "integer",
          "minimum": 1
        },
        "maxLabels": {
          "type": "integer",
          "minimum": 1
        },
        "maxCallouts": {
          "type": "integer",
          "minimum": 1
        },
        "maxShapes": {
          "type": "integer",
          "minimum": 1
        },
        "maxImageBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "position": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": true,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      ]
    },
    "size": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": true,
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        }
      ]
    },
    "body": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "pin": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/definitions/position"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "nodeHandle": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["source", "target", "both"]
        },
        "position": {
          "enum": ["left", "right", "top", "bottom"]
        },
        "side": {
          "enum": ["left", "right", "top", "bottom"]
        },
        "offset": {
          "type": "number"
        }
      }
    },
    "graphEntity": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/labels"
        },
        "data": {
          "$ref": "#/definitions/data"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "style": {
          "$ref": "#/definitions/style"
        },
        "icon": {
          "type": "string"
        }
      }
    },
    "linkDirection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/labels"
        },
        "data": {
          "$ref": "#/definitions/data"
        },
        "style": {
          "$ref": "#/definitions/style"
        }
      }
    },
    "linkDirections": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sourceToTarget": {
          "$ref": "#/definitions/linkDirection"
        },
        "targetToSource": {
          "$ref": "#/definitions/linkDirection"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "#/definitions/graphEntity"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "position": {
              "$ref": "#/definitions/position"
            },
            "parent": {
              "type": "string"
            },
            "pins": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/pin"
              }
            },
            "handles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/nodeHandle"
              }
            }
          }
        }
      ]
    },
    "link": {
      "allOf": [
        {
          "$ref": "#/definitions/graphEntity"
        },
        {
          "type": "object",
          "required": ["source", "target"],
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "sourceHandle": {
              "type": "string",
              "minLength": 1
            },
            "targetHandle": {
              "type": "string",
              "minLength": 1
            },
            "sourceLabel": {
              "type": "string",
              "minLength": 1
            },
            "targetLabel": {
              "type": "string",
              "minLength": 1
            },
            "parent": {
              "type": "string"
            },
            "directions": {
              "$ref": "#/definitions/linkDirections"
            }
          }
        }
      ]
    },
    "path": {
      "allOf": [
        {
          "$ref": "#/definitions/graphEntity"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "anyOf": [
            {
              "properties": {
                "sequence": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["sequence"]
            },
            {
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "parent": {
                  "type": "string"
                }
              },
              "required": ["source", "target", "parent"]
            }
          ],
          "properties": {
            "sequence": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "parent": {
              "type": "string"
            }
          }
        }
      ]
    },
    "region": {
      "allOf": [
        {
          "$ref": "#/definitions/graphEntity"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parent": {
