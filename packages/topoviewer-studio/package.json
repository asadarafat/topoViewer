{
  "name": "topoviewer-studio",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Private authoring application for portable TopoViewer bundles.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/contracts/host.d.ts",
      "import": "./dist/contracts/host.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js"
    },
    "./host-security": {
      "types": "./dist/hostSecurity.d.ts",
      "import": "./dist/hostSecurity.js"
    },
    "./directory-host": {
      "types": "./dist/hosts/directoryStudioHost.d.ts",
      "import": "./dist/hosts/directoryStudioHost.js"
    },
    "./starter-project": {
      "types": "./dist/hosts/starterProject.d.ts",
      "import": "./dist/hosts/starterProject.js"
    }
  },
  "files": [
    "dist",
    "ACCESSIBILITY.md",
    "ARCHITECTURE.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "vite build",
    "build:performance": "TOPOVIEWER_STUDIO_BASE=/ TOPOVIEWER_STUDIO_OUT_DIR=../../.artifacts/topoviewer-studio/performance-site vite build --mode performance",
    "build:contracts": "tsc -p tsconfig.build.json && node scripts/copy-app-assets.mjs",
    "benchmark:unit": "vitest run --no-file-parallelism --maxWorkers=1 tests/performance/document-session-performance.test.ts tests/performance/command-performance.test.ts tests/performance/mapper-performance.test.ts tests/performance/stylesheet-candidate-performance.test.ts",
    "benchmark:unit:budget": "TOPOVIEWER_PERFORMANCE_MODE=budget vitest run --no-file-parallelism --maxWorkers=1 tests/performance/document-session-performance.test.ts tests/performance/command-performance.test.ts tests/performance/mapper-performance.test.ts tests/performance/stylesheet-candidate-performance.test.ts",
    "benchmark:session": "vitest run tests/performance/document-session-performance.test.ts",
    "benchmark:commands": "vitest run tests/performance/command-performance.test.ts",
    "benchmark:mapper": "vitest run tests/performance/mapper-performance.test.ts",
    "benchmark:mapper:browser": "npm run build:performance && playwright test --config playwright.performance.config.ts tests/performance-browser/studio-mapper-performance.spec.ts",
    "benchmark:memory": "npm run build:performance && playwright test --config playwright.performance.config.ts tests/performance-browser/studio-memory-performance.spec.ts",
    "benchmark:browser": "npm run build:performance && playwright test --config playwright.performance.config.ts",
    "benchmark:startup": "npm run build:performance && playwright test --config playwright.performance.config.ts tests/performance-browser/studio-startup-performance.spec.ts",
    "benchmark:drag": "npm run build:performance && playwright test --config playwright.performance.config.ts tests/performance-browser/studio-drag-performance.spec.ts",
    "benchmark:inspector": "npm run build:performance && playwright test --config playwright.performance.config.ts tests/performance-browser/studio-inspector-performance.spec.ts",
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "preview:performance": "TOPOVIEWER_STUDIO_OUT_DIR=../../.artifacts/topoviewer-studio/performance-site vite preview --host 127.0.0.1 --port 5177 --strictPort",
    "test:browser": "npm run build:performance && playwright test --config playwright.config.ts",
    "test:production": "npm run build:performance && playwright test --config playwright.production.config.ts",
    "test:parity": "npm run build:performance && playwright test --config playwright.parity.config.ts",
    "test:accessibility": "playwright test --config playwright.config.ts tests/browser/studio-accessibility.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.1.1",
    "@xyflow/react": "^12.11.2",
    "fflate": "^0.8.3",
    "monaco-editor": "^0.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topoviewer": "0.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
