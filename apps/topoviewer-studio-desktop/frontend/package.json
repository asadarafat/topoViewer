{
  "name": "topoviewer-studio-desktop-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:golden": "tsc -p tsconfig.json --noEmit && vite build --mode golden",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "preview:golden": "vite preview --mode golden --host 127.0.0.1 --port 5180 --strictPort",
    "test": "vitest run",
    "test:golden": "npm run build:golden && playwright test --config playwright.desktop.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topoviewer-studio": "0.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
