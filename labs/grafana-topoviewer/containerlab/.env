# TopoViewer disposable local Containerlab/Grafana defaults.
# Do not copy these credentials, unsigned-plugin settings, or host ports into production.
SRLINUX_VERSION=24.10.1
SRLINUX_IMAGE=ghcr.io/nokia/srlinux:24.10.1
GNMIC_VERSION=0.40.0
GNMIC_IMAGE=ghcr.io/openconfig/gnmic:0.40.0
GRAFANA_VERSION=13.1.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
GRAFANA_HTTP_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
TOPOVIEWER_GRAFANA_PLUGIN_DIST=../../../packages/grafana-topoviewer-panel/dist
PROMETHEUS_VERSION=3.5.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PROMETHEUS_HTTP_PORT=9091
GNMIC_HTTP_PORT=9804
NORMALIZER_IMAGE=node:24.12.0-bookworm-slim
NORMALIZER_HTTP_PORT=9110
